+static NEVER_INLINE void bunValidateProfiledStructureID(CodeBlock* codeBlock, ArrayProfile* profile, StructureID id, const char* which)
+{
+    Structure* structure = id.tryDecode();
+    bool ok = structure && !(std::bit_cast<uintptr_t>(structure) & (MarkedBlock::atomSize - 1));
+    if (ok)
+        ok = structure->structureID() == codeBlock->vm().structureStructure->structureID();
+    static bool probe = !!getenv("BUN_PROBE");
+    if (probe) {
+        bool marked = structure && !(std::bit_cast<uintptr_t>(structure) & (MarkedBlock::atomSize - 1)) && codeBlock->vm().heap.isMarked(structure);
+        dataLogLn("PROBE decode ", which, " id=0x", hex(id.bits()), " ok=", ok, " marked=", marked, " scope=", (codeBlock->vm().heap.collectionScope() ? (*codeBlock->vm().heap.collectionScope() == CollectionScope::Full ? "full" : "eden") : "none"), " cb=", RawPointer(codeBlock), " ", codeBlock->inferredName());
+    }
+    if (ok) [[likely]]
+        return;
+    WTF::dataFile().flush();
+    dataLogLn("BUN-2VT0: garbage StructureID in ArrayProfile (ArrayProfile::computeUpdatedPrediction)");
+    dataLogLn("  field=", which, " raw=0x", hex(id.bits()), " profile=", RawPointer(profile), " codeBlock=", RawPointer(codeBlock), " ", *codeBlock, " jitType=", codeBlock->jitType(), " thread=", Thread::currentSingleton().uid());
+    dataLogLn("  structureIDBase=0x", hex(structureIDBase()), " decoded=", RawPointer(structure));
+    auto* bytes = std::bit_cast<uint8_t*>(profile);
+    StringPrintStream out;
+    out.print("  profile bytes (-64..+16):");
+    for (int i = -64; i < 16; ++i) {
+        if (!(i % 8))
+            out.print(" ");
+        out.printf("%02x", bytes[i]);
+    }
+    dataLogLn(out.toCString());
+    WTF::dataFile().flush();
+    CRASH_WITH_INFO(id.bits(), std::bit_cast<uintptr_t>(profile));
+}
+
 void ArrayProfile::computeUpdatedPrediction(CodeBlock* codeBlock)
 {
-    if (auto structureID = std::exchange(m_lastSeenStructureID, StructureID()))
+    if (auto structureID = std::exchange(m_lastSeenStructureID, StructureID())) {
+        bunValidateProfiledStructureID(codeBlock, this, structureID, "m_lastSeenStructureID");
         computeUpdatedPrediction(codeBlock, structureID.decode());
-    if (auto structureID = std::exchange(m_speculationFailureStructureID, StructureID()))
+    }
+    if (auto structureID = std::exchange(m_speculationFailureStructureID, StructureID())) {
+        bunValidateProfiledStructureID(codeBlock, this, structureID, "m_speculationFailureStructureID");
         computeUpdatedPrediction(codeBlock, structureID.decode());
+    }
 }
 
