+// An ArrayProfile's sampled StructureIDs are untraced. They are folded into the prediction (and cleared) by
+// CodeBlock::reconcileWeakReferencesAtGCEnd, which only runs for CodeBlocks that were visited in the current
+// collection. A CodeBlock that an eden collection did not visit keeps its samples across that cycle, so a sample can
+// name a Structure that the eden collection swept. The Structure's MarkedBlock may since have been freed and, with
+// mimalloc purging on Windows (MEM_DECOMMIT), be unreadable, so StructureID::decode() must not be dereferenced for
+// such a sample. Decide liveness from the MarkedBlock set and this cycle's mark bits, which never touches the
+// Structure's memory. A dropped sample is logged under verboseOSR so the condition stays observable.
+static bool isStructureIDLiveAtGCEnd(VM& vm, StructureID structureID, Structure*& result)
+{
+    Structure* structure = structureID.tryDecode();
+    if (!structure)
+        return false;
+    if (!MarkedBlock::isAtomAligned(structure))
+        return false;
+    MarkedBlock* candidate = MarkedBlock::blockFor(structure);
+    if (!vm.heap.objectSpace().blocks().set().contains(candidate))
+        return false;
+    Subspace* subspace = candidate->handle().subspace();
+    if (subspace != &vm.heap.structureSpace && subspace != &vm.heap.brandedStructureSpace)
+        return false;
+    // After marking, a Structure is alive iff it is marked in this cycle. This reads only the block's mark bits.
+    if (!candidate->isMarked(vm.heap.objectSpace().markingVersion(), structure))
+        return false;
+    result = structure;
+    return true;
+}
+
 void ArrayProfile::computeUpdatedPrediction(CodeBlock* codeBlock)
 {
+    VM& vm = codeBlock->vm();
+    // Only the GC-end reconcile pass can run against a Structure that died in an earlier cycle. Compiler threads and
+    // the mutator's tier-up checks run with the world running, where the MarkedBlock set cannot be consulted safely;
+    // those callers only see samples written since the last reconcile, whose Structures were alive at that point.
+    bool validateLiveness = vm.heap.currentThreadIsDoingGCWork();
